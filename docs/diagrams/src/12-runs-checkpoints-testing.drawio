ometry"><Array as="points"><mxPoint x="315" y="332"/></Array></mxGeometry></mxCell><mxCell id="12--27" value="cancel" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#4B5563;strokeWidth=1.3;fontFamily=Helvetica;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="12--7" target="12--19"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="115" y="372"/><mxPoint x="500" y="372"/></Array></mxGeometry></mxCell><mxCell id="12--28" value="resume: population or social run with a checkpoint" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#4B5563;strokeWidth=1.3;fontFamily=Helvetica;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;dashed=1;dashPattern=5 3;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="12--16" target="12--7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="572" y="265"/><mxPoint x="572" y="384"/><mxPoint x="28" y="384"/><mxPoint x="28" y="239"/></Array></mxGeometry></mxCell><mxCell id="12--29" value="" style="rounded=1;arcSize=8;html=0;fillColor=#F3F4F6;strokeColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="40" y="404" width="520" height="84" as="geometry"/></mxCell><mxCell id="12--30" value="Startup sweep" style="text;html=0;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="48.0" y="422.625" width="504" height="16.25" as="geometry"/></mxCell><mxCell id="12--31" value="Every queued or running run becomes failed with RUN_INTERRUPTED. Population and social runs&#10;with a checkpoint keep their saved work linked and can be resumed." style="text;html=0;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#374151;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="48.0" y="441.875" width="504" height="27.5" as="geometry"/></mxCell><mxCell id="12--32" value="" style="rounded=1;arcSize=8;html=0;fillColor=#F3F4F6;strokeColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="40" y="502" width="520" height="84" as="geometry"/></mxCell><mxCell id="12--33" value="Cancel" style="text;html=0;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="48.0" y="520.625" width="504" height="16.25" as="geometry"/></mxCell><mxCell id="12--34" value="A queued run is cancelled at once. A running standard run's task is cancelled. Population and social&#10;runs stop after the next checkpoint save and keep their saved work." style="text;html=0;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#374151;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="48.0" y="539.875" width="504" height="27.5" as="geometry"/></mxCell><mxCell id="12--35" value="" style="rounded=1;arcSize=8;html=0;fillColor=#FBF1DE;strokeColor=#A0680F;" vertex="1" parent="1"><mxGeometry x="40" y="600" width="520" height="98" as="geometry"/></mxCell><mxCell id="12--36" value="Checkpoint events" style="text;html=0;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="48.0" y="625.625" width="504" height="16.25" as="geometry"/></mxCell><mxCell id="12--37" value="PopulationBuilt once, InterviewBatch per batch, SocialRound per round. Each save is idempotent by&#10;index and updates Run.progress; a pending cancel raises RunCancelled after the save." style="text;html=0;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#374151;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="48.0" y="644.875" width="504" height="27.5" as="geometry"/></mxCell><mxCell id="12--38" value="" style="rounded=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#9CA3AF;dashed=1;dashPattern=5 3;" vertex="1" parent="1"><mxGeometry x="40" y="712" width="520" height="98" as="geometry"/></mxCell><mxCell id="12--39" value="Limits" style="text;html=0;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="48.0" y="737.625" width="504" height="16.25" as="geometry"/></mxCell><mxCell id="12--40" value="MAX_ACTIVE_RUNS_PER_USER active runs per user (429 RATE_LIMITED); 4 concurrent runs per&#10;process; timeouts of 15 minutes, or 60 for population and social runs; 5 s task grace on shutdown." style="text;html=0;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#374151;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="48.0" y="756.875" width="504" height="27.5" as="geometry"/></mxCell><mxCell id="12--41" value="" style="rounded=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#9CA3AF;dashed=1;dashPattern=5 3;" vertex="1" parent="1"><mxGeometry x="40" y="824" width="520" height="70" as="geometry"/></mxCell><mxCell id="12--42" value="Free-tier hosting" style="text;html=0;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="48.0" y="835.625" width="504" height="16.25" as="geometry"/></mxCell><mxCell id="12--43" value="A sleeping or restarted instance loses in-process tasks; the startup sweep records them instead of&#10;leaving them running." style="text;html=0;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#374151;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="48.0" y="854.875" width="504" height="27.5" as="geometry"/></mxCell><mxCell id="12--44" value="Tests" style="rounded=1;arcSize=3;html=0;fillColor=#FAFAFB;strokeColor=#4B5563;dashed=1;dashPattern=6 4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontFamily