" style="text;html=0;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#374151;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="628.0" y="461.0" width="324" height="41.25" as="geometry"/></mxCell><mxCell id="12--60" value="" style="rounded=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#9CA3AF;dashed=1;dashPattern=5 3;" vertex="1" parent="1"><mxGeometry x="620" y="524" width="340" height="80" as="geometry"/></mxCell><mxCell id="12--61" value="Opt-in: live services" style="text;html=0;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="628.0" y="540.625" width="324" height="16.25" as="geometry"/></mxCell><mxCell id="12--62" value="NATIVEPROOF_LIVE_TESTS=1 for live Qloo; pytest -m&#10;live_supabase for Supabase auth" style="text;html=0;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#374151;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="628.0" y="559.875" width="324" height="27.5" as="geometry"/></mxCell><mxCell id="12--63" value="" style="rounded=1;arcSize=8;html=0;fillColor=#E7EFFA;strokeColor=#3E6AA8;" vertex="1" parent="1"><mxGeometry x="620" y="616" width="340" height="64" as="geometry"/></mxCell><mxCell id="12--64" value="Frontend" style="text;html=0;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="628.0" y="631.5" width="324" height="16.25" as="geometry"/></mxCell><mxCell id="12--65" value="npm run typecheck, npm run lint, npm run build" style="text;html=0;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#374151;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="628.0" y="650.75" width="324" height="13.75" as="geometry"/></mxCell><mxCell id="12--66" value="" style="rounded=1;arcSize=8;html=0;fillColor=#E7EFFA;strokeColor=#3E6AA8;" vertex="1" parent="1"><mxGeometry x="620" y="692" width="340" height="64" as="geometry"/></mxCell><mxCell id="12--67" value="End to end" style="text;html=0;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="628.0" y="707.5" width="324" height="16.25" as="geometry"/></mxCell><mxCell id="12--68" value="Playwright in e2e/ against a running frontend and backend" style="text;html=0;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#374151;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="628.0" y="726.75" width="324" height="13.75" as="geometry"/></mxCell><mxCell id="12--69" value="" style="rounded=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#9CA3AF;dashed=1;dashPattern=5 3;" vertex="1" parent="1"><mxGeometry x="620" y="768" width="340" height="64" as="geometry"/></mxCell><mxCell id="12--70" value="Hermetic by default" style="text;html=0;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="628.0" y="776.625" width="324" height="16.25" as="geometry"/></mxCell><mxCell id="12--71" value="fake providers and fixtures; no paid API call in the default test&#10;run" style="text;html=0;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#374151;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="628.0" y="795.875" width="324" height="27.5" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
