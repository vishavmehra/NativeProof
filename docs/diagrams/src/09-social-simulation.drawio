<mxfile host="drawio" type="device"><diagram id="09-social-simulation" name="09-social-simulation"><mxGraphModel dx="1000" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="850" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="09--1" value="Multi-round social simulation" style="text;html=0;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=18;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="960" height="28" as="geometry"/></mxCell><mxCell id="09--2" value="Illustrative dynamics on a seeded peer network. Every stance change is traceable to the posts a participant saw." style="text;html=0;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#4B5563;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="44" width="960" height="16" as="geometry"/></mxCell><mxCell id="09--3" value="" style="rounded=1;arcSize=8;html=0;fillColor=#FBF1DE;strokeColor=#A0680F;" vertex="1" parent="1"><mxGeometry x="20" y="96" width="280" height="70" as="geometry"/></mxCell><mxCell id="09--4" value="Population study" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="28.0" y="114.5" width="264" height="16.25" as="geometry"/></mxCell><mxCell id="09--5" value="completed or partial" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#374151;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="28.0" y="133.75" width="264" height="13.75" as="geometry"/></mxCell><mxCell id="09--6" value="" style="rounded=1;arcSize=8;html=0;fillColor=#F3F4F6;strokeColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="340" y="96" width="320" height="96" as="geometry"/></mxCell><mxCell id="09--7" value="building_network" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="348.0" y="113.75" width="304" height="16.25" as="geometry"/></mxCell><mxCell id="09--8" value="a seeded peer network: each participant links to 6 peers by&#10;Jaccard overlap of interest ids, about 75% within its own&#10;group" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#374151;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="348.0" y="133.0" width="304" height="41.25" as="geometry"/></mxCell><mxCell id="09--9" value="" style="rounded=1;arcSize=8;html=0;fillColor=#FBF1DE;strokeColor=#A0680F;" vertex="1" parent="1"><mxGeometry x="700" y="96" width="280" height="70" as="geometry"/></mxCell><mxCell id="09--10" value="Initial stances" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="708.0" y="114.5" width="264" height="16.25" as="geometry"/></mxCell><mxCell id="09--11" value="each participant's interview reaction" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#374151;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="708.0" y="133.75" width="264" height="13.75" as="geometry"/></mxCell><mxCell id="09--12" value="Each round, r = 1 to N (N at most 5); completed rounds are skipped on resume" style="rounded=1;arcSize=3;html=0;fillColor=#F6FBF7;strokeColor=#2F7D4C;dashed=1;dashPattern=6 4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#2F7D4C;" vertex="1" parent="1"><mxGeometry x="20" y="222" width="960" height="352" as="geometry"/></mxCell><mxCell id="09--13" value="" style="rounded=1;arcSize=8;html=0;fillColor=#F3F4F6;strokeColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="40" y="262" width="280" height="84" as="geometry"/></mxCell><mxCell id="09--14" value="Active participants" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="48.0" y="287.5" width="264" height="16.25" as="geometry"/></mxCell><mxCell id="09--15" value="a seeded active_share acts in this round" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#374151;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="48.0" y="306.75" width="264" height="13.75" as="geometry"/></mxCell><mxCell id="09--16" value="" style="rounded=1;arcSize=8;html=0;fillColor=#F3F4F6;strokeColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="350" y="262" width="300" height="100" as="geometry"/></mxCell><mxCell id="09--17" value="Feed" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="358.0" y="281.75" width="284" height="16.25" as="geometry"/></mxCell><mxCell id="09--18" value="up to feed_size items from network neighbours: their&#10;interview answers in round 1, their latest posts first in&#10;later rounds" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#374151;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="358.0" y="301.0" width="284" height="41.25" as="geometry"/></mxCell><mxCell id="09--19" value="" style="rounded=1;arcSize=8;html=0;fillColor=#E6F4EA;strokeColor=#2F7D4C;" vertex="1" parent="1"><mxGeometry x="680" y="262" width="280" height="100" as="geometry"/></mxCell><mxCell id="09--20" value="Batched model call" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="688.0" y="281.75" width="264" height="16.25" as="geometry"/></mxCell><mxCell id="09--21" value="10 participants per call; each returns an action (post,&#10;comment, share, ignore), a stance, a reason, and an&#10;optional reply target" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#374151;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="688.0" y="301.0" width="264" height="41.25" as="geometry"/></mxCell><mxCell id="09--22" value="" style="rounded=1;arcSize=8;html=0;fillColor=#FBF1DE;strokeColor=#A0680F;" vertex="1" parent="1"><mxGeometry x="680" y="392" width="280" height="160" as="geometry"/></mxCell><mxCell id="09--23" value="SocialPost" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="688.0" y="428.0" width="264" height="16.25" as="geometry"/></mxCell><mxCell id="09--24" value="round_index, participant, action, text&#10;previous_stance and stance&#10;reason&#10;seen_post_ids: the exact feed&#10;parent_post_id for comments and shares" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#374151;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="688.0" y="447.25" width="264" height="68.75" as="geometry"/></mxCell><mxCell id="09--25" value="" style="rounded=1;arcSize=8;html=0;fillColor=#FBF1DE;strokeColor=#A0680F;" vertex="1" parent="1"><mxGeometry x="350" y="392" width="300" height="100" as="geometry"/></mxCell><mxCell id="09--26" value="Checkpoint: SocialRound" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="358.0" y="418.625" width="284" height="16.25" as="geometry"/></mxCell><mxCell id="09--27" value="posts and current stances; the round summary counts&#10;stance shifts; idempotent by round index" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#374151;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="358.0" y="437.875" width="284" height="27.5" as="geometry"/></mxCell><mxCell id="09--28" value="" style="rounded=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#9CA3AF;dashed=1;dashPattern=5 3;" vertex="1" parent="1"><mxGeometry x="40" y="392" width="280" height="160" as="geometry"/></mxCell><mxCell id="09--29" value="Example, fictional" style="text;html=0;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="48.0" y="434.875" width="264" height="16.25" as="geometry"/></mxCell><mxCell id="09--30" value="In round 2 a participant sees two neighbour posts,&#10;moves from mixed to positive, and gives a reason.&#10;Its post stores both stances, the reason, and the ids&#10;of the two posts it saw." style="text;html=0;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#374151;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="48.0" y="454.125" width="264" height="55.0" as="geometry"/></mxCell><mxCell id="09--31" value="" style="rounded=1;arcSize=8;html=0;fillColor=#F3F4F6;strokeColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="20" y="606" width="280" height="76" as="geometry"/></mxCell><mxCell id="09--32" value="analysing_dynamics" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="28.0" y="627.5" width="264" height="16.25" as="geometry"/></mxCell><mxCell id="09--33" value="stance distributions before and after, by group" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#374151;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="28.0" y="646.75" width="264" height="13.75" as="geometry"/></mxCell><mxCell id="09--34" value="" style="rounded=1;arcSize=8;html=0;fillColor=#E6F4EA;strokeColor=#2F7D4C;" vertex="1" parent="1"><mxGeometry x="340" y="606" width="320" height="90" as="geometry"/></mxCell><mxCell id="09--35" value="summarizing" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="348.0" y="627.625" width="304" height="16.25" as="geometry"/></mxCell><mxCell id="09--36" value="a model describes influence paths from changed stances and&#10;cites post ids; labeled interpretation" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#374151;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="348.0" y="646.875" width="304" height="27.5" as="geometry"/></mxCell><mxCell id="09--37" value="" style="rounded=1;arcSize=8;html=0;fillColor=#FBF1DE;strokeColor=#A0680F;" vertex="1" parent="1"><mxGeometry x="700" y="606" width="280" height="90" as="geometry"/></mxCell><mxCell id="09--38" value="SocialSimulationResult" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="708.0" y="627.625" width="264" height="16.25" as="geometry"/></mxCell><mxCell id="09--39" value="labeled: simulated social dynamics, illustrative, not&#10;a forecast; every agent shares one model" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#374151;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="708.0" y="646.875" width="264" height="27.5" as="geometry"/></mxCell><mxCell id="09--40" value="" style="rounded=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#9CA3AF;dashed=1;dashPattern=5 3;" vertex="1" parent="1"><mxGeometry x="20" y="716" width="960" height="56" as="geometry"/></mxCell><mxCell id="09--41" value="Diffusion view" style="text;html=0;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="28.0" y="727.5" width="944" height="16.25" as="geometry"/></mxCell><mxCell id="09--42" value="influenced edges come from seen_post_ids (post to post, and author group to reader group); replied_to edges come from parent_post_id." style="text;html=0;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#374151;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="28.0" y="746.75" width="944" height="13.75" as="geometry"/></mxCell><mxCell id="09--43" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#4B5563;strokeWidth=1.3;fontFamily=Helvetica;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;" edge="1" parent="1" source="09--3" target="09--6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="09--44" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#4B5563;strokeWidth=1.3;fontFamily=Helvetica;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;" edge="1" parent="1" source="09--6" target="09--9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="09--45" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#4B5563;strokeWidth=1.3;fontFamily=Helvetica;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="09--9" target="09--13"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="840" y="204"/><mxPoint x="26" y="204"/><mxPoint x="26" y="304"/></Array></mxGeometry></mxCell><mxCell id="09--46" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#4B5563;strokeWidth=1.3;fontFamily=Helvetica;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;" edge="1" parent="1" source="09--13" target="09--16"><mxGeometry relative="1" as="geometry"/></mxCell><mxC