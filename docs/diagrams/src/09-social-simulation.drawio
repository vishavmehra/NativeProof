Geometry x="265" y="815" width="22" height="13" as="geometry"/></mxCell><mxCell id="09--59" value="Model-backed step" style="text;html=0;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#1F2933;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="295" y="812" width="195" height="20" as="geometry"/></mxCell><mxCell id="09--60" value="" style="rounded=1;arcSize=20;html=0;fillColor=#FBF1DE;strokeColor=#A0680F;" vertex="1" parent="1"><mxGeometry x="500" y="815" width="22" height="13" as="geometry"/></mxCell><mxCell id="09--61" value="Stored data" style="text;html=0;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#1F2933;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="530" y="812" width="195" height="20" as="geometry"/></mxCell><mxCell id="09--62" value="" style="rounded=1;arcSize=20;html=0;fillColor=#FFFFFF;strokeColor=#9CA3AF;dashed=1;" vertex="1" parent="1"><mxGeometry x="735" y="815" width="22" height="13" as="geometry"/></mxCell><mxCell id="09--63" value="Note or rule" style="text;html=0;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#1F2933;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="765" y="812" width="195" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
