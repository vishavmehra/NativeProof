<mxfile host="drawio" type="device"><diagram id="06-model-gateway" name="06-model-gateway"><mxGraphModel dx="1000" dy="860" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="860" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="06--1" value="AI model gateway and routing" style="text;html=0;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=18;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="960" height="28" as="geometry"/></mxCell><mxCell id="06--2" value="Every agent call goes through one gateway: route, call, retry, fall back, validate, repair, record." style="text;html=0;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#4B5563;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="44" width="960" height="16" as="geometry"/></mxCell><mxCell id="06--3" value="" style="rounded=1;arcSize=8;html=0;fillColor=#E6F4EA;strokeColor=#2F7D4C;" vertex="1" parent="1"><mxGeometry x="20" y="96" width="290" height="70" as="geometry"/></mxCell><mxCell id="06--4" value="Agent call" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="28.0" y="114.5" width="274" height="16.25" as="geometry"/></mxCell><mxCell id="06--5" value="task class, output schema, prompt version" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#374151;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="28.0" y="133.75" width="274" height="13.75" as="geometry"/></mxCell><mxCell id="06--6" value="" style="rounded=1;arcSize=8;html=0;fillColor=#F3F4F6;strokeColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="20" y="186" width="290" height="140" as="geometry"/></mxCell><mxCell id="06--7" value="Routing table (routing-v1)" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="28.0" y="212.0" width="274" height="16.25" as="geometry"/></mxCell><mxCell id="06--8" value="fast: extraction, sentiment_analysis&#10;default: research_synthesis, study_design,&#10;synthetic_generation, creative_adaptation,&#10;comparative_judgment, report_generation&#10;reasoning: risk_analysis" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#374151;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="28.0" y="231.25" width="274" height="68.75" as="geometry"/></mxCell><mxCell id="06--9" value="" style="rounded=1;arcSize=8;html=0;fillColor=#F3F4F6;strokeColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="20" y="346" width="290" height="90" as="geometry"/></mxCell><mxCell id="06--10" value="Tier model from settings" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="28.0" y="353.875" width="274" height="16.25" as="geometry"/></mxCell><mxCell id="06--11" value="NEBIUS_FAST_MODEL,&#10;NEBIUS_DEFAULT_MODEL,&#10;NEBIUS_REASONING_MODEL; fast and reasoning fall&#10;back to the default" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#374151;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="28.0" y="373.125" width="274" height="55.0" as="geometry"/></mxCell><mxCell id="06--12" value="" style="rounded=1;arcSize=8;html=0;fillColor=#F3F4F6;strokeColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="20" y="456" width="290" height="90" as="geometry"/></mxCell><mxCell id="06--13" value="Capability registry" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="28.0" y="477.625" width="274" height="16.25" as="geometry"/></mxCell><mxCell id="06--14" value="verified models get response_format json_schema or&#10;json_object; others get none and rely on validation" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#374151;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="28.0" y="496.875" width="274" height="27.5" as="geometry"/></mxCell><mxCell id="06--15" value="" style="rounded=1;arcSize=8;html=0;fillColor=#E6F4EA;strokeColor=#2F7D4C;" vertex="1" parent="1"><mxGeometry x="20" y="570" width="290" height="130" as="geometry"/></mxCell><mxCell id="06--16" value="Capabilities" style="text;html=0;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="28.0" y="591.0" width="274" height="16.25" as="geometry"/></mxCell><mxCell id="06--17" value="LLMGateway.capability() routes embeddings&#10;(EMBEDDING_*) and vision (VISION_*) with their own&#10;timeouts and deadlines. They are unavailable when&#10;not configured and in demo mode. An image never&#10;goes to a text-only model." style="text;html=0;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#374151;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="28.0" y="610.25" width="274" height="68.75" as="geometry"/></mxCell><mxCell id="06--18" value="" style="rounded=1;arcSize=8;html=0;fillColor=#EFE9F7;strokeColor=#6A4C9C;" vertex="1" parent="1"><mxGeometry x="350" y="96" width="290" height="96" as="geometry"/></mxCell><mxCell id="06--19" value="Nebius Token Factory" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="358.0" y="113.75" width="274" height="16.25" as="geometry"/></mxCell><mxCell id="06--20" value="OpenAI-compatible call; per-request timeout&#10;LLM_REQUEST_TIMEOUT_SECONDS; the whole&#10;call is capped at 2.5 times that timeout" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#374151;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="358.0" y="133.0" width="274" height="41.25" as="geometry"/></mxCell><mxCell id="06--21" value="" style="rhombus;html=0;fillColor=#F3F4F6;strokeColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="390" y="212" width="210" height="96" as="geometry"/></mxCell><mxCell id="06--22" value="Transient error?" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=12;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="429.9" y="237.25" width="130.2" height="15.0" as="geometry"/></mxCell><mxCell id="06--23" value="timeout, 429, 5xx,&#10;connection" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#374151;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="429.9" y="255.25" width="130.2" height="27.5" as="geometry"/></mxCell><mxCell id="06--24" value="" style="rounded=1;arcSize=8;html=0;fillColor=#F3F4F6;strokeColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="350" y="328" width="290" height="64" as="geometry"/></mxCell><mxCell id="06--25" value="Bounded retries" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="358.0" y="336.625" width="274" height="16.25" as="geometry"/></mxCell><mxCell id="06--26" value="LLM_MAX_RETRIES with backoff; Retry-After is&#10;honored" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#374151;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="358.0" y="355.875" width="274" height="27.5" as="geometry"/></mxCell><mxCell id="06--27" value="" style="rhombus;html=0;fillColor=#F3F4F6;strokeColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="390" y="412" width="210" height="100" as="geometry"/></mxCell><mxCell id="06--28" value="Retries used up and&#10;fallback enabled?" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=12;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="429.9" y="447.0" width="130.2" height="30.0" as="geometry"/></mxCell><mxCell id="06--29" value="" style="rounded=1;arcSize=8;html=0;fillColor=#EFE9F7;strokeColor=#6A4C9C;" vertex="1" parent="1"><mxGeometry x="350" y="532" width="290" height="80" as="geometry"/></mxCell><mxCell id="06--30" value="OpenRouter fallback" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="358.0" y="541.75" width="274" height="16.25" as="geometry"/></mxCell><mxCell id="06--31" value="LLM_FALLBACK_ENABLED with&#10;OPENROUTER_DEFAULT_MODEL; recorded as&#10;fallback_used" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#374151;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="358.0" y="561.0" width="274" height="41.25" as="geometry"/></mxCell><mxCell id="06--32" value="" style="rounded=1;arcSize=8;html=0;fillColor=#FBEAEA;strokeColor=#A33A32;" vertex="1" parent="1"><mxGeometry x="350" y="624" width="290" height="66" as="geometry"/></mxCell><mxCell id="06--33" value="LLMError: provider" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="358.0" y="633.625" width="274" height="16.25" as="geometry"/></mxCell><mxCell id="06--34" value="PROVIDER_ERROR or PROVIDER_TIMEOUT, with a&#10;retryable flag" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#374151;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="358.0" y="652.875" width="274" height="27.5" as="geometry"/></mxCell><mxCell id="06--35" value="" style="rounded=1;arcSize=8;html=0;fillColor=#F3F4F6;strokeColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="680" y="96" width="300" height="70" as="geometry"/></mxCell><mxCell id="06--36" value="Parse JSON" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="688.0" y="114.5" width="284" height="16.25" as="geometry"/></mxCell><mxCell id="06--37" value="validate against the Pydantic output schema" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#374151;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="688.0" y="133.75" width="284" height="13.75" as="geometry"/></mxCell><mxCell id="06--38" value="" style="rhombus;html=0;fillColor=#F3F4F6;strokeColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="680" y="186" width="150" height="90" as="geometry"/></mxCell><mxCell id="06--39" value="Valid?" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="708.5" y="222.875" width="93.0" height="16.25" as="geometry"/></mxCell><mxCell id="06--40" value="" style="rounded=1;arcSize=8;html=0;fillColor=#F3F4F6;strokeColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="850" y="196" width="130" height="70" as="geometry"/></mxCell><mxCell id="06--41" value="LLMResult" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="858.0" y="214.5" width="114" height="16.25" as="geometry"/></mxCell><mxCell id="06--42" value="value plus StepTrace" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#374151;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="858.0" y="233.75" width="114" height="13.75" as="geometry"/></mxCell><mxCell id="06--43" value="" style="rounded=1;arcSize=8;html=0;fillColor=#E6F4EA;strokeColor=#2F7D4C;" vertex="1" parent="1"><mxGeometry x="680" y="296" width="300" height="64" as="geometry"/></mxCell><mxCell id="06--44" value="One constrained repair" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="688.0" y="311.5" width="284" height="16.25" as="geometry"/></mxCell><mxCell id="06--45" value="the model is asked to fix the reported validation errors" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#374151;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="688.0" y="330.75" width="284" height="13.75" as="geometry"/></mxCell><mxCell id="06--46" value="" style="rhombus;html=0;fillColor=#F3F4F6;strokeColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="680" y="380" width="150" height="90" as="geometry"/></mxCell><mxCell id="06--47" value="Valid?" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="708.5" y="416.875" width="93.0" height="16.25" as="geometry"/></mxCell><mxCell id="06--48" value="" style="rounded=1;arcSize=8;html=0;fillColor=#FBEAEA;strokeColor=#A33A32;" vertex="1" parent="1"><mxGeometry x="680" y="490" width="300" height="64" as="geometry"/></mxCell><mxCell id="06--49" value="LLMError: invalid output" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="688.0" y="505.5" width="284" height="16.25" as="geometry"/></mxCell><mxCell id="06--50" value="distinct from a provider error" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#374151;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="688.0" y="524.75" width="284" height="13.75" as="geometry"/></mxCell><mxCell id="06--51" value="" style="rounded=1;arcSize=8;html=0;fillColor=#FBF1DE;strokeColor=#A0680F;" vertex="1" parent="1"><mxGeometry x="350" y="714" width="630" height="76" as="geometry"/></mxCell><mxCell id="06--52" value="StepTrace for every stage, stored in agent_runs.steps" style="text;html=0;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="358.0" y="728.625" width="614" height="16.25" as="geometry"/></mxCell><mxCell id="06--53" value="stage, agent, provider, model_id, prompt_version, schema_version, latency_ms, retries, fallback_used, sampling, usage&#10;tokens, error_code" style="text;html=0;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#374151;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="358.0" y="747.875" width="614" height="27.5" as="geometry"/></mxCell><mxCell id="06--54" value="" style="rounded=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#9CA3AF;dashed=1;dashPattern=5 3;" vertex="1" parent="1"><mxGeometry x="20" y="720" width="290" height="70" as="geometry"/></mxCell><mxCell id="06--55" value="Prompts and outputs are never logged. Demo projects&#10;use a fixture provider with no external call." style="text;html=0;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#374151;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="28.0" y="741.25" width="274" height="27.5" as="geometry"/></mxCell><mxCell id="06--56" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#4B5563;strokeWidth=1.3;fontFamily=Helvetica;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;" edge="1" parent="1" source="06--3" target="06--6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="06--57" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#4B5563;strokeWidth=1.3;fontFamily=Helvetica;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=bloc