# Copy to backend/.env and fill in. Never commit real values.
# Every variable here is server-side only.

# --- Application ---
# development | test | production
APP_ENV=development
LOG_LEVEL=INFO
# Comma-separated CORS allow-list
FRONTEND_ORIGINS=http://localhost:3000

# --- Authentication ---
# supabase | dev  (dev is refused when APP_ENV=production)
AUTH_MODE=dev
# https://<project-ref>.supabase.co — JWKS at <SUPABASE_URL>/auth/v1/.well-known/jwks.json
SUPABASE_URL=
# Optional: only for projects that still sign tokens with the legacy HS256 secret
SUPABASE_JWT_SECRET=

# --- Database ---
# Local: sqlite+aiosqlite:///./nativeproof.db   Supabase: postgresql+asyncpg://...
DATABASE_URL=sqlite+aiosqlite:///./nativeproof.db

# --- LLM providers ---
LLM_PRIMARY_PROVIDER=nebius
NEBIUS_API_KEY=
# Verified 2026-10-25 against docs.tokenfactory.nebius.com
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Model ids must come from GET {NEBIUS_BASE_URL}models and pass a structured-output check
# Verified 2026-10-26 with real inference (docs/15 §1-5)
NEBIUS_DEFAULT_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507
NEBIUS_FAST_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507
NEBIUS_REASONING_MODEL=deepseek-ai/DeepSeek-V4-Pro
LLM_FALLBACK_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=
OPENROUTER_DEFAULT_MODEL=
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# --- Qloo (official hackathon harness, @qloo/qloo-harness >= 0.1.26) ---
# Event credential; setting it enables live mode (verify with `uv run python -m scripts.qloo_live_smoke`)
QLOO_API_KEY=
# Leave blank for the official host (https://api.qloo.com). Set https://hackathon.api.qloo.com only if the
# event key belongs to that host (the smoke script's --base-url tells you).
QLOO_BASE_URL=
# Blank = auto: the official harness when Node and the pinned harness exist, else direct REST. Or: harness | rest
QLOO_TRANSPORT=
# Path to the qloo CLI
QLOO_BIN=qloo
QLOO_TIMEOUT_SECONDS=30

# --- Capability routing (docs/15_MODEL_SELECTION.md; set a model only after real inference passes) ---
# Provider per capability: nebius | openrouter. The OpenRouter key on file is free tier: only ":free" models work.
# Verified 2026-10-26 (docs/15 §6-7).
EMBEDDING_PROVIDER=nebius
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
EMBEDDING_DIMENSIONS=4096
VISION_PROVIDER=nebius
VISION_MODEL=openbmb/MiniCPM-V-4_5
RERANK_PROVIDER=
RERANK_MODEL=

# --- Uploaded assets ---
# database (default; bytes in a table, for local development and tests) or supabase (private Storage bucket
# `assets`, created by migration 0006). supabase needs SUPABASE_URL and SUPABASE_SECRET_KEY; startup fails without them.
ASSET_STORAGE_BACKEND=database
# Server-side Supabase secret key (sb_secret_...): Storage access only. Never put it in the frontend.
SUPABASE_SECRET_KEY=
MAX_IMAGE_BYTES=5242880

# --- Limits ---
MAX_ACTIVE_RUNS_PER_USER=2
# Largest live population study accepted; larger requests get a 422 that names the limit.
POPULATION_MAX_PARTICIPANTS=600
