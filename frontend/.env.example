# Copy to frontend/.env.local. Only NEXT_PUBLIC_* values reach the browser — never put secrets here.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# supabase | dev  (dev sends the backend's development token; local only)
NEXT_PUBLIC_AUTH_MODE=dev
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 1 = serve contracts/fixtures through the development mock transport (ignored in production builds)
NEXT_PUBLIC_API_MOCK=0
