<mxfile host="drawio" type="device"><diagram id="05-qloo-evidence-pipeline" name="05-qloo-evidence-pipeline"><mxGraphModel dx="1000" dy="960" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="960" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="05--1" value="Qloo evidence pipeline and provenance" style="text;html=0;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=18;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="960" height="28" as="geometry"/></mxCell><mxCell id="05--2" value="From reference terms to stored, labeled evidence records. Demo projects use the same normalization on fixtures." style="text;html=0;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#4B5563;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="44" width="960" height="16" as="geometry"/></mxCell><mxCell id="05--3" value="" style="rounded=1;arcSize=8;html=0;fillColor=#E7EFFA;strokeColor=#3E6AA8;" vertex="1" parent="1"><mxGeometry x="20" y="96" width="280" height="70" as="geometry"/></mxCell><mxCell id="05--4" value="Discovery request" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="28.0" y="114.5" width="264" height="16.25" as="geometry"/></mxCell><mxCell id="05--5" value="reference terms, concept, market" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#374151;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="28.0" y="133.75" width="264" height="13.75" as="geometry"/></mxCell><mxCell id="05--6" value="" style="rounded=1;arcSize=8;html=0;fillColor=#E7EFFA;strokeColor=#3E6AA8;" vertex="1" parent="1"><mxGeometry x="20" y="186" width="280" height="80" as="geometry"/></mxCell><mxCell id="05--7" value="confirmed_references" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="28.0" y="202.625" width="264" height="16.25" as="geometry"/></mxCell><mxCell id="05--8" value="the person's choice for an ambiguous term: term,&#10;ref_id, ref_kind" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#374151;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="28.0" y="221.875" width="264" height="27.5" as="geometry"/></mxCell><mxCell id="05--9" value="" style="rounded=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#9CA3AF;dashed=1;dashPattern=5 3;" vertex="1" parent="1"><mxGeometry x="20" y="430" width="280" height="130" as="geometry"/></mxCell><mxCell id="05--10" value="Demo projects" style="text;html=0;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="28.0" y="457.875" width="264" height="16.25" as="geometry"/></mxCell><mxCell id="05--11" value="A fixture executor returns labeled, hand-authored&#10;envelopes. No Qloo call is made and the cache is&#10;never touched. A fixture envelope that reaches the&#10;live adapter is rejected." style="text;html=0;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#374151;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="28.0" y="477.125" width="264" height="55.0" as="geometry"/></mxCell><mxCell id="05--12" value="" style="rounded=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#9CA3AF;dashed=1;dashPattern=5 3;" vertex="1" parent="1"><mxGeometry x="20" y="580" width="280" height="110" as="geometry"/></mxCell><mxCell id="05--13" value="Downstream use" style="text;html=0;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="28.0" y="604.75" width="264" height="16.25" as="geometry"/></mxCell><mxCell id="05--14" value="Market briefs, Cultural DNA, population groups, and&#10;risk findings cite evidence ids. Model text built on&#10;them is labeled interpretation." style="text;html=0;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#374151;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="28.0" y="624.0" width="264" height="41.25" as="geometry"/></mxCell><mxCell id="05--15" value="" style="rounded=1;arcSize=8;html=0;fillColor=#F3F4F6;strokeColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="340" y="96" width="300" height="70" as="geometry"/></mxCell><mxCell id="05--16" value="Resolve each term" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="348.0" y="114.5" width="284" height="16.25" as="geometry"/></mxCell><mxCell id="05--17" value="find_tags for tags, search_entities for entities" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#374151;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="348.0" y="133.75" width="284" height="13.75" as="geometry"/></mxCell><mxCell id="05--18" value="" style="rhombus;html=0;fillColor=#F3F4F6;strokeColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="370" y="186" width="240" height="100" as="geometry"/></mxCell><mxCell id="05--19" value="Top candidate a&#10;near-exact, unique name&#10;match?" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=12;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="415.6" y="213.5" width="148.8" height="45.0" as="geometry"/></mxCell><mxCell id="05--20" value="" style="rounded=1;arcSize=8;html=0;fillColor=#F3F4F6;strokeColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="336" y="310" width="90" height="90" as="geometry"/></mxCell><mxCell id="05--21" value="resolved" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="344.0" y="346.875" width="74" height="16.25" as="geometry"/></mxCell><mxCell id="05--22" value="" style="rounded=1;arcSize=8;html=0;fillColor=#FBEAEA;strokeColor=#A33A32;" vertex="1" parent="1"><mxGeometry x="436" y="310" width="108" height="90" as="geometry"/></mxCell><mxCell id="05--23" value="ambiguous" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=12;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="444.0" y="325.375" width="92" height="15.0" as="geometry"/></mxCell><mxCell id="05--24" value="shown to the&#10;person; never&#10;used downstream" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#374151;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="444.0" y="343.375" width="92" height="41.25" as="geometry"/></mxCell><mxCell id="05--25" value="" style="rounded=1;arcSize=8;html=0;fillColor=#FBEAEA;strokeColor=#A33A32;" vertex="1" parent="1"><mxGeometry x="556" y="310" width="108" height="90" as="geometry"/></mxCell><mxCell id="05--26" value="unresolved" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=12;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="564.0" y="339.125" width="92" height="15.0" as="geometry"/></mxCell><mxCell id="05--27" value="no candidates" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#374151;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="564.0" y="357.125" width="92" height="13.75" as="geometry"/></mxCell><mxCell id="05--28" value="" style="rounded=1;arcSize=8;html=0;fillColor=#F3F4F6;strokeColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="340" y="420" width="300" height="70" as="geometry"/></mxCell><mxCell id="05--29" value="Related interests" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="348.0" y="431.625" width="284" height="16.25" as="geometry"/></mxCell><mxCell id="05--30" value="recommend through Insights; the market region is the&#10;audience-location signal" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#374151;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="348.0" y="450.875" width="284" height="27.5" as="geometry"/></mxCell><mxCell id="05--31" value="" style="rounded=1;arcSize=8;html=0;fillColor=#F3F4F6;strokeColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="340" y="510" width="300" height="76" as="geometry"/></mxCell><mxCell id="05--32" value="Relevance check" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="348.0" y="524.625" width="284" height="16.25" as="geometry"/></mxCell><mxCell id="05--33" value="keep results that carry the seed's Qloo tag; drop the rest&#10;and record a note" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#374151;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="348.0" y="543.875" width="284" height="27.5" as="geometry"/></mxCell><mxCell id="05--34" value="" style="rounded=1;arcSize=8;html=0;fillColor=#F3F4F6;strokeColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="340" y="604" width="300" height="66" as="geometry"/></mxCell><mxCell id="05--35" value="Demographics and trends" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="348.0" y="620.5" width="284" height="16.25" as="geometry"/></mxCell><mxCell id="05--36" value="aggregate audience data and popularity, where requested" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#374151;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="348.0" y="639.75" width="284" height="13.75" as="geometry"/></mxCell><mxCell id="05--37" value="" style="rounded=1;arcSize=8;html=0;fillColor=#FBF1DE;strokeColor=#A0680F;" vertex="1" parent="1"><mxGeometry x="340" y="686" width="300" height="120" as="geometry"/></mxCell><mxCell id="05--38" value="Evidence record" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="348.0" y="702.0" width="284" height="16.25" as="geometry"/></mxCell><mxCell id="05--39" value="evidence_type qloo_source, claim_type observed&#10;retrieval_mode live, cached, or fixture; is_live_data&#10;retrieved_at, limitations&#10;provenance: request_hash, response_hash,&#10;normalizer_version, fixture_origin" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#374151;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="348.0" y="721.25" width="284" height="68.75" as="geometry"/></mxCell><mxCell id="05--40" value="" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=9;html=0;fillColor=#FBF1DE;strokeColor=#A0680F;" vertex="1" parent="1"><mxGeometry x="340" y="826" width="300" height="80" as="geometry"/></mxCell><mxCell id="05--41" value="evidence_records" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="348.0" y="854.0" width="284" height="16.25" as="geometry"/></mxCell><mxCell id="05--42" value="linked to the source run" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#374151;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="348.0" y="873.25" width="284" height="13.75" as="geometry"/></mxCell><mxCell id="05--43" value="" style="rounded=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#9CA3AF;dashed=1;dashPattern=5 3;" vertex="1" parent="1"><mxGeometry x="680" y="96" width="300" height="90" as="geometry"/></mxCell><mxCell id="05--44" value="Venues" style="text;html=0;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="688.0" y="117.625" width="284" height="16.25" as="geometry"/></mxCell><mxCell id="05--45" value="Entity search never resolves a venue (urn:entity:place)&#10;automatically; the person can confirm one." style="text;html=0;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#374151;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="688.0" y="136.875" width="284" height="27.5" as="geometry"/></mxCell><mxCell id="05--46" value="" style="rounded=1;arcSize=8;html=0;fillColor=#F3F4F6;strokeColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="680" y="420" width="300" height="110" as="geometry"/></mxCell><mxCell id="05--47" value="Executor" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="688.0" y="444.75" width="284" height="16.25" as="geometry"/></mxCell><mxCell id="05--48" value="allowlisted workflows with validated inputs&#10;transport: qloo exec harness or direct REST&#10;up to 3 attempts; bounded output" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#374151;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="688.0" y="464.0" width="284" height="41.25" as="geometry"/></mxCell><mxCell id="05--49" value="" style="rounded=1;arcSize=8;html=0;fillColor=#FBF1DE;strokeColor=#A0680F;" vertex="1" parent="1"><mxGeometry x="680" y="550" width="300" height="130" as="geometry"/></mxCell><mxCell id="05--50" value="Qloo cache, live results only" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="688.0" y="571.0" width="284" height="16.25" as="geometry"/></mxCell><mxCell id="05--51" value="key: sha256 of workflow, request, and normalizer&#10;version&#10;TTL: 7 days for tags, search, demographics; 24 hours&#10;for recommend and trends&#10;partial and error results are never cached" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#374151;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="688.0" y="590.25" width="284" height="68.75" as="geometry"/></mxCell><mxCell id="05--52" value="" style="rounded=1;arcSize=8;html=0;fillColor=#EFE9F7;strokeColor=#6A4C9C;" vertex="1" parent="1"><mxGeometry x="680" y="700" width="300" height="56" as="geometry"/></mxCell><mxCell id="05--53" value="Qloo API" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="688.0" y="719.875" width="284" height="16.25" as="geometry"/></mxCell><mxCell id="05--54" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#4B5563;strokeWidth=1.3;fontFamily=Helvetica;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="05--3" target="05--15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="05--55" value="confirmed id replaces matching" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#4B5563;strokeWidth=1.3;fontFamily=Helvetica;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;exitX=1;exitY=0.4;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="05--6" target="05--15"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="322" y="218"/><mxPoint x="322" y="148"/></Array></mxGeometry></mxCell><mxCell id="05--56" val