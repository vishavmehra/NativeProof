<mxfile host="drawio" type="device"><diagram id="07-population-generation" name="07-population-generation"><mxGraphModel dx="1000" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="820" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="07--1" value="Synthetic population generation" style="text;html=0;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=18;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="960" height="28" as="geometry"/></mxCell><mxCell id="07--2" value="Stages 1 and 2 of a population study: evidence, then groups, then seeded participants. No demographics on any participant." style="text;html=0;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#4B5563;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="44" width="960" height="16" as="geometry"/></mxCell><mxCell id="07--3" value="Stage 1: preparing_evidence" style="rounded=1;arcSize=3;html=0;fillColor=#FAFAFB;strokeColor=#4B5563;dashed=1;dashPattern=6 4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="960" height="230" as="geometry"/></mxCell><mxCell id="07--4" value="" style="rounded=1;arcSize=8;html=0;fillColor=#E7EFFA;strokeColor=#3E6AA8;" vertex="1" parent="1"><mxGeometry x="40" y="118" width="220" height="76" as="geometry"/></mxCell><mxCell id="07--5" value="Study and campaign version" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="48.0" y="139.5" width="204" height="16.25" as="geometry"/></mxCell><mxCell id="07--6" value="regions come from the study's markets" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#374151;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="48.0" y="158.75" width="204" height="13.75" as="geometry"/></mxCell><mxCell id="07--7" value="" style="rounded=1;arcSize=8;html=0;fillColor=#FBF1DE;strokeColor=#A0680F;" vertex="1" parent="1"><mxGeometry x="40" y="212" width="220" height="80" as="geometry"/></mxCell><mxCell id="07--8" value="Discovery evidence" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="48.0" y="228.625" width="204" height="16.25" as="geometry"/></mxCell><mxCell id="07--9" value="discovery_run_id, or the campaign's&#10;latest linked discovery" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#374151;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="48.0" y="247.875" width="204" height="27.5" as="geometry"/></mxCell><mxCell id="07--10" value="" style="rounded=1;arcSize=8;html=0;fillColor=#F3F4F6;strokeColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="290" y="118" width="400" height="174" as="geometry"/></mxCell><mxCell id="07--11" value="Collect population evidence (Qloo)" style="text;html=0;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="298.0" y="140.375" width="384" height="16.25" as="geometry"/></mxCell><mxCell id="07--12" value="Seeds: references the discovery resolved or the person confirmed, then the&#10;concept and reference terms under the near-exact rule. Ambiguous or&#10;unresolved terms are never used.&#10;Per region: related brands from Insights with the region as the&#10;audience-location signal, then the relevance check.&#10;Demographics are aggregate audience data: they may ground a group, never&#10;a participant.&#10;Live calls go through the Qloo cache; every record carries provenance." style="text;html=0;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#374151;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="298.0" y="159.625" width="384" height="110.0" as="geometry"/></mxCell><mxCell id="07--13" value="" style="rounded=1;arcSize=8;html=0;fillColor=#FBEAEA;strokeColor=#A33A32;" vertex="1" parent="1"><mxGeometry x="720" y="118" width="240" height="80" as="geometry"/></mxCell><mxCell id="07--14" value="Qloo unreachable on every call" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="728.0" y="134.625" width="224" height="16.25" as="geometry"/></mxCell><mxCell id="07--15" value="the run stops before any model call; nothing&#10;is saved" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#374151;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="728.0" y="153.875" width="224" height="27.5" as="geometry"/></mxCell><mxCell id="07--16" value="" style="rounded=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#9CA3AF;dashed=1;dashPattern=5 3;" vertex="1" parent="1"><mxGeometry x="720" y="212" width="240" height="80" as="geometry"/></mxCell><mxCell id="07--17" value="No usable evidence" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="728.0" y="221.75" width="224" height="16.25" as="geometry"/></mxCell><mxCell id="07--18" value="the population is ungrounded&#10;(grounded=false) and every group is labeled&#10;a hypothesis" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#374151;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="728.0" y="241.0" width="224" height="41.25" as="geometry"/></mxCell><mxCell id="07--19" value="Stage 2: constructing_population" style="rounded=1;arcSize=3;html=0;fillColor=#FAFAFB;strokeColor=#4B5563;dashed=1;dashPattern=6 4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="20" y="340" width="960" height="300" as="geometry"/></mxCell><mxCell id="07--20" value="" style="rounded=1;arcSize=8;html=0;fillColor=#E6F4EA;strokeColor=#2F7D4C;" vertex="1" parent="1"><mxGeometry x="40" y="388" width="280" height="106" as="geometry"/></mxCell><mxCell id="07--21" value="Groups, 3 to 12" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="48.0" y="410.75" width="264" height="16.25" as="geometry"/></mxCell><mxCell id="07--22" value="A model writes audience archetypes: label, interests&#10;weighted by evidence rank, and the evidence_ids&#10;they cite." style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#374151;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="48.0" y="430.0" width="264" height="41.25" as="geometry"/></mxCell><mxCell id="07--23" value="" style="rounded=1;arcSize=8;html=0;fillColor=#F3F4F6;strokeColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="340" y="388" width="260" height="106" as="geometry"/></mxCell><mxCell id="07--24" value="Validation" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="348.0" y="410.75" width="244" height="16.25" as="geometry"/></mxCell><mxCell id="07--25" value="Group text that names a demographic or&#10;sensitive trait fails; the gateway's single repair&#10;asks the model to remove it." style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#374151;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="348.0" y="430.0" width="244" height="41.25" as="geometry"/></mxCell><mxCell id="07--26" value="" style="rounded=1;arcSize=8;html=0;fillColor=#F3F4F6;strokeColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="620" y="388" width="340" height="106" as="geometry"/></mxCell><mxCell id="07--27" value="Seeded expansion, deterministic" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="628.0" y="410.75" width="324" height="16.25" as="geometry"/></mxCell><mxCell id="07--28" value="Participants are allocated by group share. Each gets a subset of&#10;the group's interests and one value per trait knob, drawn with the&#10;run seed." style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#374151;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="628.0" y="430.0" width="324" height="41.25" as="geometry"/></mxCell><mxCell id="07--29" value="" style="rounded=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#9CA3AF;dashed=1;dashPattern=5 3;" vertex="1" parent="1"><mxGeometry x="620" y="506" width="340" height="116" as="geometry"/></mxCell><mxCell id="07--30" value="Trait knobs" style="text;html=0;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="628.0" y="533.75" width="324" height="16.25" as="geometry"/></mxCell><mxCell id="07--31" value="adoption_style, price_sensitivity, media_habit, tone_preference&#10;No age, gender, ethnicity, religion, health, income, or other&#10;sensitive or demographic trait is invented." style="text;html=0;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#374151;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="628.0" y="553.0" width="324" height="41.25" as="geometry"/></mxCell><mxCell id="07--32" value="" style="rounded=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#9CA3AF;dashed=1;dashPattern=5 3;" vertex="1" parent="1"><mxGeometry x="40" y="506" width="560" height="116" as="geometry"/></mxCell><mxCell id="07--33" value="Reproducible people" style="text;html=0;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="48.0" y="540.625" width="544" height="16.25" as="geometry"/></mxCell><mxCell id="07--34" value="The same population id always yields the same participants, so campaign versions are tested on identical&#10;people. A group's share is an allocation choice, not a market share or prevalence." style="text;html=0;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#374151;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="48.0" y="559.875" width="544" height="27.5" as="geometry"/></mxCell><mxCell id="07--35" value="" style="rounded=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#9CA3AF;dashed=1;dashPattern=5 3;" vertex="1" parent="1"><mxGeometry x="20" y="660" width="470" height="84" as="geometry"/></mxCell><mxCell id="07--36" value="Size limits" style="text;html=0;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="28.0" y="678.625" width="454" height="16.25" as="geometry"/></mxCell><mxCell id="07--37" value="20 to 2,000 participants. A request above the configured work limit is refused with 422&#10;and the limit; it is never shrunk. Demo projects are capped at 120." style="text;html=0;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#374151;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="28.0" y="697.875" width="454" height="27.5" as="geometry"/></mxCell><mxCell id="07--38" value="" style="rounded=1;arcSize=8;html=0;fillColor=#FBF1DE;strokeColor=#A0680F;" vertex="1" parent="1"><mxGeometry x="510" y="660" width="470" height="84" as="geometry"/></mxCell><mxCell id="07--39" value="Checkpoint: PopulationBuilt" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="518.0" y="678.625" width="454" height="16.25" as="geometry"/></mxCell><mxCell id="07--40" value="stores the populations and participants rows; cited Qloo evidence is saved first, so a&#10;resumed run never cites unsaved records" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#374151;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="518.0" y="697.875" width="454" height="27.5" as="geometry"/></mxCell><mxCell id="07--41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#4B5563;strokeWidth=1.3;fontFamily=Helvetica;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="07--4" target="07--10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="07--42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#4B5563;strokeWidth=1.3;fontFamily=Helvetica;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="07--7" target="07--10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="07--43" value="every call failed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#4B5563;strokeWidth=1.3;fontFamily=Helvetica;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;dashed=1;dashPattern=5 3;exitX=1;exitY=0.27;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="07--10" target="07--13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="07--44" value="no evidence" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#4B5563;strokeWidth=1.3;fontFamily=Helvetica;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;dashed=1;dashPattern=5 3;exitX=1;exitY=0.81;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="07--10" target="07--16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="07--45" value="evidence" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#4B5563;strokeWidth=1.3;fontFamily=Helvetica;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="07--10" target="07--20"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="490" y="374"/><mxPoint x="180" y="374"/></Array></mxGeometry></mxCell><mxCell id="07--46" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#4B5563;strokeWidth=1.3;fontFamily=Helvetica;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;" edge="1" parent="1" source="07--20" target="07--23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="07--47" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#4B5563;strokeWidth=1.3;fontFamily=Helvetica;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;" edge="1" parent="1" source="07--23" target="07--26"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="07--48" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#4B5563;strokeWidth=1.3;fontFamily=Helvetica;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="07--26" target="07--38"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="972" y="441"/><mxPoint x="972" y="702"/></Array></mxGeometry></mxCell><mxCell id="07--49" value="" style="rounded=1;arcSize=4;html=0;fillColor=#FFFFFF;strokeColor=#D1D5DB;" vertex="1" parent="1"><mxGeometry x="20" y="752" width="958" height="52" as="geometry"/></mxCell><mxCell id="07--50" value="Legend" style="text;html=0;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="30" y="758" width="100" height="18" as="geometry"/></mxCell><mxCell id="07--51" value="" style="rounded=1;arcSize=20;html=0;fillColor=#E7EFFA;strokeColor=#3E6AA8;" vertex="1" parent="1"><mxGeometry x="30" y="783" width="22" height="13" as="geometry"/></mxCell><mxCell id="07--52" value="Web app (browser)" style="text;html=0;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#1F2933;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="780" width="118" height="20" as="geometry"/></mxCell><mxCell id="07--53" value="" style="rounded=1;arcSize=20;html=0;fillColor=#F3F4F6;strokeColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="188" y="783" width="22" height="13" as="geometry"/></mxCell><mxCell id="07--54" value="Deterministic code" style="text;html=0;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#1F2933;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="218" y="780" width="118" height="20" as="geometry"/></mxCell><mxCell id="07--55" value="" style="rounded=1;arcSize=20;html=0;fillColor=#E6F4EA;strokeColor=#2F7D4C;" vertex="1" parent="1"><mxGeometry x="346" y="783" width="22" height="13" as="geometry"/></mxCell><mxCell id="07--56" value="Model-backed step" style="text;html=0;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#1F2933;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="376" y="780" width="118" height="20" as="geometry"/></mxCell><mxCell id="07--57" value="" style="rounded=1;arcSize=20;html=0;fillColor=#FBF1DE;strokeColor=#A0680F;" vertex="1" parent="1"><mxGeometry x="504" y="783" width="22" height="13" as="geometry"/></mxCell><mxCell id="07--58" value="Stored data" style="text;html=0;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#1F2933;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="534" y="780" width="118" height="20" as="geometry"/></mxCell><mxCell id="07--59" value="" style="rounded=1;arcSize=20;html=0;fillColor=#FBEAEA;strokeColor=#A33A32;" vertex="1" parent="1"><mxGeometry x="662" y="783" width="22" height="13" as="geometry"/></mxCell><mxCell id="07--60" value="Failure or refusal" style="text;html=0;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#1F2933;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="692" y="780" width="118" height="20" as="geometry"/></mxCell><mxCell id="07--61" value="" style="rounded=1;arcSize=20;html=0;fillColor=#FFFFFF;strokeColor=#9CA3AF;dashed=1;" vertex="1" parent="1"><mxGeometry x="820" y="783" width="22" height="13" as="geometry"/></mxCell><mxCell id="07--62" value="Note or rule" style="text;html=0;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#1F2933;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="850" y="780" width="118" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
