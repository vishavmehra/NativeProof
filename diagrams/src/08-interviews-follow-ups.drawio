538.0" y="513.625" width="414" height="16.25" as="geometry"/></mxCell><mxCell id="08--42" value="Answers are synthetic and labeled. They are never presented as a real person's&#10;opinion." style="text;html=0;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#374151;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="538.0" y="532.875" width="414" height="27.5" as="geometry"/></mxCell><mxCell id="08--43" value="" style="rounded=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#9CA3AF;dashed=1;dashPattern=5 3;" vertex="1" parent="1"><mxGeometry x="530" y="590" width="430" height="74" as="geometry"/></mxCell><mxCell id="08--44" value="Demo projects" style="text;html=0;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="538.0" y="603.625" width="414" height="16.25" as="geometry"/></mxCell><mxCell id="08--45" value="A labeled fixture answer quotes the participant's stored interview. No provider is&#10;called." style="text;html=0;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#374151;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="538.0" y="622.875" width="414" height="27.5" as="geometry"/></mxCell><mxCell id="08--46" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#4B5563;strokeWidth=1.3;fontFamily=Helvetica;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;" edge="1" parent="1" source="08--4" target="08--6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="08--47" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#4B5563;strokeWidth=1.3;fontFamily=Helvetica;fontSize=11;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;" edge="1" parent="1" source="08--6" target="08--9"><mxGeometry relative="1" as="geometry"/></mxCe