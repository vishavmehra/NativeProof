<mxfile host="drawio" type="device"><diagram id="08-interviews-follow-ups" name="08-interviews-follow-ups"><mxGraphModel dx="1000" dy="860" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="860" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="08--1" value="Interviews and follow-ups" style="text;html=0;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=18;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="960" height="28" as="geometry"/></mxCell><mxCell id="08--2" value="Stages 3 and 4 of a population study, and the questions a person can ask afterwards." style="text;html=0;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#4B5563;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="44" width="960" height="16" as="geometry"/></mxCell><mxCell id="08--3" value="Interviews (stages 3 and 4)" style="rounded=1;arcSize=3;html=0;fillColor=#FAFAFB;strokeColor=#4B5563;dashed=1;dashPattern=6 4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="20" y="76" width="470" height="704" as="geometry"/></mxCell><mxCell id="08--4" value="" style="rounded=1;arcSize=8;html=0;fillColor=#FBF1DE;strokeColor=#A0680F;" vertex="1" parent="1"><mxGeometry x="40" y="114" width="430" height="50" as="geometry"/></mxCell><mxCell id="08--5" value="Participants of the population" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="48.0" y="130.875" width="414" height="16.25" as="geometry"/></mxCell><mxCell id="08--6" value="" style="rounded=1;arcSize=8;html=0;fillColor=#F3F4F6;strokeColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="40" y="184" width="430" height="64" as="geometry"/></mxCell><mxCell id="08--7" value="Batches of 10 participants" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="48.0" y="199.5" width="414" height="16.25" as="geometry"/></mxCell><mxCell id="08--8" value="up to 3 batches in flight; checkpoints are still written in batch order" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#374151;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="48.0" y="218.75" width="414" height="13.75" as="geometry"/></mxCell><mxCell id="08--9" value="" style="rounded=1;arcSize=8;html=0;fillColor=#E6F4EA;strokeColor=#2F7D4C;" vertex="1" parent="1"><mxGeometry x="40" y="268" width="430" height="128" as="geometry"/></mxCell><mxCell id="08--10" value="Fast-tier model, one call per batch" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="48.0" y="294.875" width="414" height="16.25" as="geometry"/></mxCell><mxCell id="08--11" value="Each participant answers from its own profile. Core protocol: first_impression,&#10;comprehension, relevance, appeal, confusion, trust, concerns, improvement.&#10;Depth brief, standard, or deep adds 0, 1, or 2 adaptive follow-ups. A creative&#10;appears only as verified vision observations." style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#374151;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="48.0" y="314.125" width="414" height="55.0" as="geometry"/></mxCell><mxCell id="08--12" value="" style="rounded=1;arcSize=8;html=0;fillColor=#FBF1DE;strokeColor=#A0680F;" vertex="1" parent="1"><mxGeometry x="40" y="416" width="430" height="82" as="geometry"/></mxCell><mxCell id="08--13" value="Checkpoint: InterviewBatch" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="48.0" y="433.625" width="414" height="16.25" as="geometry"/></mxCell><mxCell id="08--14" value="interviews rows, idempotent by batch index; a failed batch is stored as failed&#10;interviews and is not retried in a loop" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#374151;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="48.0" y="452.875" width="414" height="27.5" as="geometry"/></mxCell><mxCell id="08--15" value="" style="rounded=1;arcSize=8;html=0;fillColor=#F3F4F6;strokeColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="40" y="518" width="430" height="98" as="geometry"/></mxCell><mxCell id="08--16" value="Deterministic tallies" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="48.0" y="543.625" width="414" height="16.25" as="geometry"/></mxCell><mxCell id="08--17" value="reaction distribution: rates = counts / completed interviews, with failures reported&#10;beside them; themes, concerns, and misunderstandings by group and region" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#374151;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="48.0" y="562.875" width="414" height="27.5" as="geometry"/></mxCell><mxCell id="08--18" value="" style="rounded=1;arcSize=8;html=0;fillColor=#E6F4EA;strokeColor=#2F7D4C;" vertex="1" parent="1"><mxGeometry x="40" y="636" width="430" height="66" as="geometry"/></mxCell><mxCell id="08--19" value="Interpretation of the tallies" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="48.0" y="652.5" width="414" height="16.25" as="geometry"/></mxCell><mxCell id="08--20" value="group differences and next actions, labeled model interpretation" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#374151;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="48.0" y="671.75" width="414" height="13.75" as="geometry"/></mxCell><mxCell id="08--21" value="" style="rounded=1;arcSize=8;html=0;fillColor=#FBF1DE;strokeColor=#A0680F;" vertex="1" parent="1"><mxGeometry x="40" y="718" width="430" height="50" as="geometry"/></mxCell><mxCell id="08--22" value="PopulationStudyResult" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="48.0" y="726.5" width="414" height="16.25" as="geometry"/></mxCell><mxCell id="08--23" value="carries the synthetic disclosure" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#374151;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="48.0" y="745.75" width="414" height="13.75" as="geometry"/></mxCell><mxCell id="08--24" value="Follow-ups and group questions" style="rounded=1;arcSize=3;html=0;fillColor=#FAFAFB;strokeColor=#4B5563;dashed=1;dashPattern=6 4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="510" y="76" width="470" height="704" as="geometry"/></mxCell><mxCell id="08--25" value="" style="rounded=1;arcSize=8;html=0;fillColor=#FBF1DE;strokeColor=#A0680F;" vertex="1" parent="1"><mxGeometry x="530" y="114" width="430" height="112" as="geometry"/></mxCell><mxCell id="08--26" value="Participant detail" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="538.0" y="139.75" width="414" height="16.25" as="geometry"/></mxCell><mxCell id="08--27" value="profile; state: the latest stance and its source; memories from stored records only:&#10;interview answers, posts seen, own posts, earlier follow-ups. Most recent first, at&#10;most 50." style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#374151;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="538.0" y="159.0" width="414" height="41.25" as="geometry"/></mxCell><mxCell id="08--28" value="" style="rounded=1;arcSize=8;html=0;fillColor=#E6F4EA;strokeColor=#2F7D4C;" vertex="1" parent="1"><mxGeometry x="530" y="250" width="205" height="96" as="geometry"/></mxCell><mxCell id="08--29" value="Ask one participant" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="538.0" y="274.625" width="189" height="16.25" as="geometry"/></mxCell><mxCell id="08--30" value="one bounded model call, in character,&#10;with the memory window" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#374151;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="538.0" y="293.875" width="189" height="27.5" as="geometry"/></mxCell><mxCell id="08--31" value="" style="rounded=1;arcSize=8;html=0;fillColor=#E6F4EA;strokeColor=#2F7D4C;" vertex="1" parent="1"><mxGeometry x="755" y="250" width="205" height="96" as="geometry"/></mxCell><mxCell id="08--32" value="Ask a group" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="763.0" y="274.625" width="189" height="16.25" as="geometry"/></mxCell><mxCell id="08--33" value="a seeded sample of 3 to 10&#10;participants in one batched call" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#374151;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="763.0" y="293.875" width="189" height="27.5" as="geometry"/></mxCell><mxCell id="08--34" value="" style="rounded=1;arcSize=8;html=