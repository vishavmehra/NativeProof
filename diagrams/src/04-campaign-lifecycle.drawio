<mxfile host="drawio" type="device"><diagram id="04-campaign-lifecycle" name="04-campaign-lifecycle"><mxGraphModel dx="1000" dy="790" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="790" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="04--1" value="Campaign lifecycle" style="text;html=0;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=18;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="960" height="28" as="geometry"/></mxCell><mxCell id="04--2" value="From a project to an evidence-backed report. Run types are shown in each step." style="text;html=0;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#4B5563;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="44" width="960" height="16" as="geometry"/></mxCell><mxCell id="04--3" value="" style="rounded=1;arcSize=8;html=0;fillColor=#F3F4F6;strokeColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="20" y="100" width="220" height="96" as="geometry"/></mxCell><mxCell id="04--4" value="Project" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="28.0" y="124.625" width="204" height="16.25" as="geometry"/></mxCell><mxCell id="04--5" value="live or demo, fixed at creation; demo&#10;projects are seeded with labeled fixtures" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#374151;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="28.0" y="143.875" width="204" height="27.5" as="geometry"/></mxCell><mxCell id="04--6" value="" style="rounded=1;arcSize=8;html=0;fillColor=#F3F4F6;strokeColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="266" y="100" width="220" height="96" as="geometry"/></mxCell><mxCell id="04--7" value="Campaign" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="274.0" y="124.625" width="204" height="16.25" as="geometry"/></mxCell><mxCell id="04--8" value="type, objective, target markets,&#10;evaluation criteria" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#374151;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="274.0" y="143.875" width="204" height="27.5" as="geometry"/></mxCell><mxCell id="04--9" value="" style="rounded=1;arcSize=8;html=0;fillColor=#FBF1DE;strokeColor=#A0680F;" vertex="1" parent="1"><mxGeometry x="512" y="100" width="220" height="96" as="geometry"/></mxCell><mxCell id="04--10" value="Content version" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="520.0" y="124.625" width="204" height="16.25" as="geometry"/></mxCell><mxCell id="04--11" value="immutable snapshot: headline, body,&#10;call to action, reference terms" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#374151;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="520.0" y="143.875" width="204" height="27.5" as="geometry"/></mxCell><mxCell id="04--12" value="" style="rounded=1;arcSize=8;html=0;fillColor=#FBF1DE;strokeColor=#A0680F;" vertex="1" parent="1"><mxGeometry x="758" y="100" width="220" height="96" as="geometry"/></mxCell><mxCell id="04--13" value="Brand Memory" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="766.0" y="124.625" width="204" height="16.25" as="geometry"/></mxCell><mxCell id="04--14" value="written only by people; Cultural DNA,&#10;Voice, Arena, and Risk Radar read it" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#374151;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="766.0" y="143.875" width="204" height="27.5" as="geometry"/></mxCell><mxCell id="04--15" value="" style="rounded=1;arcSize=8;html=0;fillColor=#E6F4EA;strokeColor=#2F7D4C;" vertex="1" parent="1"><mxGeometry x="20" y="250" width="220" height="96" as="geometry"/></mxCell><mxCell id="04--16" value="Audience" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="28.0" y="260.875" width="204" height="16.25" as="geometry"/></mxCell><mxCell id="04--17" value="campaign_rehearsal: synthetic&#10;reactions; population_study: participants&#10;and interviews; optional&#10;social_simulation" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#374151;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="28.0" y="280.125" width="204" height="55.0" as="geometry"/></mxCell><mxCell id="04--18" value="" style="rounded=1;arcSize=8;html=0;fillColor=#F3F4F6;strokeColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="266" y="250" width="220" height="96" as="geometry"/></mxCell><mxCell id="04--19" value="Study" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="274.0" y="274.625" width="204" height="16.25" as="geometry"/></mxCell><mxCell id="04--20" value="market, segments, dimensions, research&#10;questions" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#374151;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="274.0" y="293.875" width="204" height="27.5" as="geometry"/></mxCell><mxCell id="04--21" value="" style="rounded=1;arcSize=8;html=0;fillColor=#E6F4EA;strokeColor=#2F7D4C;" vertex="1" parent="1"><mxGeometry x="512" y="250" width="220" height="96" as="geometry"/></mxCell><mxCell id="04--22" value="Atlas discovery" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="520.0" y="267.75" width="204" height="16.25" as="geometry"/></mxCell><mxCell id="04--23" value="market_discovery: resolve references,&#10;retrieve Qloo affinities, write a market&#10;brief" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#374151;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="520.0" y="287.0" width="204" height="41.25" as="geometry"/></mxCell><mxCell id="04--24" value="" style="rounded=1;arcSize=8;html=0;fillColor=#E6F4EA;strokeColor=#2F7D4C;" vertex="1" parent="1"><mxGeometry x="20" y="400" width="220" height="96" as="geometry"/></mxCell><mxCell id="04--25" value="Voice adaptation" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="28.0" y="424.625" width="204" height="16.25" as="geometry"/></mxCell><mxCell id="04--26" value="campaign_adaptation: 1 to 3 variants,&#10;protected-term checks, risk review" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#374151;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="28.0" y="443.875" width="204" height="27.5" as="geometry"/></mxCell><mxCell id="04--27" value="" style="rounded=1;arcSize=8;html=0;fillColor=#E7EFFA;strokeColor=#3E6AA8;" vertex="1" parent="1"><mxGeometry x="266" y="400" width="220" height="96" as="geometry"/></mxCell><mxCell id="04--28" value="User edits, optional" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="274.0" y="424.625" width="204" height="16.25" as="geometry"/></mxCell><mxCell id="04--29" value="revisions are new adaptations;&#10;deterministic checks run again" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#374151;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="274.0" y="443.875" width="204" height="27.5" as="geometry"/></mxCell><mxCell id="04--30" value="" style="rounded=1;arcSize=8;html=0;fillColor=#E6F4EA;strokeColor=#2F7D4C;" vertex="1" parent="1"><mxGeometry x="512" y="400" width="220" height="96" as="geometry"/></mxCell><mxCell id="04--31" value="Loop evaluation" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="520.0" y="417.75" width="204" height="16.25" as="geometry"/></mxCell><mxCell id="04--32" value="campaign_evaluation: the original plus&#10;up to 3 adaptations, scoring mvp-1,&#10;rules R0 to R5" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#374151;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="520.0" y="437.0" width="204" height="41.25" as="geometry"/></mxCell><mxCell id="04--33" value="" style="rounded=1;arcSize=8;html=0;fillColor=#F3F4F6;strokeColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="758" y="400" width="220" height="96" as="geometry"/></mxCell><mxCell id="04--34" value="Recommendation" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontColor=#1F2933;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="766.0" y="417.75" width="204" height="16.25" as="geometry"/></mxCell><mxCell id="04--35" value="accept for the next internal review,&#10;revise, validate with real people, or&#10;inconclusive" style="text;html=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#374151;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="766.0" y="437.0" width="204" height="41.25" as="geometry"/></mxCell><mxCell id="04--36" value="" style="rounded=1;arcSize=8;html=0;fillColor=#FBF1DE;strokeColor=#A068